@dataclass
class LatencyHistogram:
    """Tracks latency percentiles for performance monitoring."""

    window_size: int = 1000
    _samples: deque = field(default_factory=deque, init=False)

    def record(self, latency_ms: float) -> None:
        """Record a latency sample."""
        self._samples.append(latency_ms)
        if len(self._samples) > self.window_size:
            self._samples.popleft()

    def percentiles(self) -> dict[str, float]:
        """Calculate common percentiles (p50, p95, p99)."""
        if not self._samples:
            return {"p50": 0.0, "p95": 0.0, "p99": 0.0, "mean": 0.0, "max": 0.0}

        sorted_samples = sorted(self._samples)
        count = len(sorted_samples)

        def _percentile(p: float) -> float:
            idx = int(count * p)
            return sorted_samples[min(idx, count - 1)]

        return {
            "p50": _percentile(0.50),
            "p95": _percentile(0.95),
            "p99": _percentile(0.99),
            "mean": sum(sorted_samples) / count,
            "max": max(sorted_samples),
        }


@dataclass
class ErrorRateTracker:
    """Tracks error rates over a rolling time window."""

    window_seconds: float = 60.0
    _successes: deque = field(default_factory=deque, init=False)
    _failures: deque = field(default_factory=deque, init=False)

    def record_success(self) -> None:
        """Record a successful operation."""
        self._successes.append(datetime.now(UTC))
        self._cleanup()

    def record_failure(self) -> None:
        """Record a failed operation."""
        self._failures.append(datetime.now(UTC))
        self._cleanup()

    def _cleanup(self) -> None:
        """Remove timestamps outside the window."""
        cutoff = datetime.now(UTC) - timedelta(seconds=self.window_seconds)
        while self._successes and self._successes[0] < cutoff:
            self._successes.popleft()
        while self._failures and self._failures[0] < cutoff:
            self._failures.popleft()

    def error_rate(self) -> float:
        """Calculate current error rate (0.0 to 1.0)."""
        self._cleanup()
        total = len(self._successes) + len(self._failures)
        if total == 0:
            return 0.0
        return len(self._failures) / total

    def stats(self) -> dict[str, Any]:
        """Get detailed error rate statistics."""
        self._cleanup()
        return {
            "successes": len(self._successes),
            "failures": len(self._failures),
            "error_rate": self.error_rate(),
            "window_seconds": self.window_seconds,
        }


class AgentTelemetry:
    """Enterprise telemetry middleware with advanced metrics."""

    def __init__(
        self,
        *,
        flow_name: str,
        logger: logging.Logger,
        status_callback: Callable[[StatusUpdate], None] | None = None,
    ) -> None:
        self.flow_name = flow_name
        self.logger = logger
        self._status_callback = status_callback
        self.events: list[PlannerEvent] = []

        # Advanced metrics
        self._latency_histograms: dict[str, LatencyHistogram] = defaultdict(LatencyHistogram)
        self._error_trackers: dict[str, ErrorRateTracker] = defaultdict(ErrorRateTracker)
        self._circuit_breaker_states: dict[str, str] = {}
{% if mlflow_enabled %}
        self._mlflow: Any | None = None
        self._mlflow_unavailable = False
        self._mlflow_run: ContextVar[_MlflowRun | None] = ContextVar("mlflow_run", default=None)
{% endif %}

    def record_planner_event(self, event: PlannerEvent) -> None:
        """Synchronous callback attached to the planner."""
        self.events.append(event)
        payload: dict[str, Any] = {"flow": self.flow_name, **event.to_payload()}
{% if mlflow_enabled %}
        self._record_mlflow_event(event)
{% endif %}

        # Track latency for step_complete events
        if event.event_type == "step_complete" and event.latency_ms is not None:
            node_name = event.node_name or "unknown"
            self._latency_histograms[node_name].record(event.latency_ms)

            # Log if latency is unusually high (> p95)
            percentiles = self._latency_histograms[node_name].percentiles()
            if event.latency_ms > percentiles["p95"]:
                self.logger.warning(
                    "high_latency_detected",
                    extra={**payload, "p95": percentiles["p95"]},
                )

        # Track error rates - errors are indicated by the error field, not event_type
        if event.event_type == "step_complete":
            node_name = event.node_name or "unknown"
            if event.error:
                self._error_trackers[node_name].record_failure()
                self.logger.error("planner_node_error", extra=payload)

                # Alert if error rate is high
                error_rate = self._error_trackers[node_name].error_rate()
                if error_rate > 0.1:  # > 10% error rate
                    self.logger.error(
                        "high_error_rate",
                        extra={
                            "node_name": node_name,
                            "error_rate": error_rate,
                            **self._error_trackers[node_name].stats(),
                        },
                    )
            else:
                self._error_trackers[node_name].record_success()

        # Log finish events
        if event.event_type == "finish":
            self.logger.info("planner_finish", extra=payload)
        elif event.event_type != "step_complete":
            self.logger.debug(event.event_type, extra=payload)

{% if mlflow_enabled %}
    def _mlflow_module(self) -> Any | None:
        if self._mlflow_unavailable:
            return None
        if self._mlflow is None:
            try:
                import mlflow
            except ImportError:
                self._mlflow_unavailable = True
                self.logger.warning("mlflow telemetry disabled: package unavailable")
                return None
            if not hasattr(mlflow, "start_span"):
                self._mlflow_unavailable = True
                self.logger.warning("mlflow telemetry disabled: tracing API unavailable")
                return None
            self._mlflow = mlflow
        return self._mlflow

    def _set_attributes(self, span: Any, attributes: dict[str, Any]) -> None:
        try:
            span.set_attributes(attributes)
        except Exception:
            self.logger.debug("mlflow span attribute error", exc_info=True)

    def _set_inputs(self, span: Any, inputs: Any) -> None:
        try:
            span.set_inputs(inputs)
        except Exception:
            self.logger.debug("mlflow span input error", exc_info=True)

    def _set_outputs(self, span: Any, outputs: Any) -> None:
        try:
            span.set_outputs(outputs)
        except Exception:
            self.logger.debug("mlflow span output error", exc_info=True)

    def _event_payload(self, value: Any) -> Any:
        if isinstance(value, str):
            try:
                return json.loads(value)
            except ValueError:
                return value
        return value

    def _open_span(self, name: str, span_type: str) -> tuple[Any, Any] | None:
        mlflow = self._mlflow_module()
        if mlflow is None:
            return None
        try:
            context = mlflow.start_span(name=name, span_type=span_type)
            return context.__enter__(), context
        except Exception:
            self.logger.debug("mlflow span start error", exc_info=True)
            return None

    def _close_span(self, span: Any, context: Any, attributes: dict[str, Any] | None = None) -> None:
        if attributes:
            self._set_attributes(span, attributes)
        try:
            context.__exit__(None, None, None)
        except Exception:
            self.logger.debug("mlflow span close error", exc_info=True)

    def _set_status(self, span: Any, status: str) -> None:
        try:
            span.set_status(status)
        except Exception:
            self.logger.debug("mlflow span status error", exc_info=True)

    def _open_tool_span(self, name: str, parent_span: Any) -> Any | None:
        mlflow = self._mlflow_module()
        if mlflow is None or not hasattr(mlflow, "start_span_no_context"):
            return None
        try:
            return mlflow.start_span_no_context(name=name, span_type="TOOL", parent_span=parent_span)
        except Exception:
            self.logger.debug("mlflow tool span start error", exc_info=True)
            return None

    def _close_tool_span(self, span: Any, status: str) -> None:
        try:
            span.end(status=status)
        except Exception:
            self.logger.debug("mlflow tool span close error", exc_info=True)

    @contextmanager
    def trace_agent_run(self, *, operation: str, trace_id: str, inputs: Any = None) -> Any:
        opened = self._open_span(f"agent.{operation}", "AGENT")
        if opened is None:
            yield
            return
        span, context = opened
        self._set_attributes(span, {"flow.name": self.flow_name, "operation": operation, "trace_id": trace_id})
        if inputs is not None:
            self._set_inputs(span, inputs)
        run = _MlflowRun(span=span)
        token = self._mlflow_run.set(run)
        outcome = "ok"
        try:
            yield
        except BaseException:
            outcome = "error"
            raise
        finally:
            for tool_span in run.tools.values():
                self._close_tool_span(tool_span, "UNSET")
            self._mlflow_run.reset(token)
            self._set_status(span, "OK" if outcome == "ok" else "ERROR")
            self._close_span(span, context, {"outcome": outcome})

    def record_agent_output(self, output: Any) -> None:
        run = self._mlflow_run.get()
        if run is not None:
            self._set_outputs(run.span, output)

    def _record_mlflow_event(self, event: PlannerEvent) -> None:
        run = self._mlflow_run.get()
        if run is None:
            return
        tool_call_id = event.extra.get("tool_call_id")
        if not isinstance(tool_call_id, str):
            return
        if event.event_type == "tool_call_start":
            if tool_call_id in run.tools:
                return
            tool_name = event.extra.get("tool_name")
            span = self._open_tool_span(
                str(tool_name) if isinstance(tool_name, str) else "tool.call", run.span
            )
            if span is None:
                return
            self._set_attributes(span, {
                "tool.call_id": tool_call_id,
                "tool.name": tool_name if isinstance(tool_name, str) else "unknown",
                "trajectory.step": event.trajectory_step,
                "action.sequence": event.extra.get("action_seq", 0),
            })
            args = event.extra.get("args_json")
            if args is not None:
                self._set_inputs(span, self._event_payload(args))
            run.tools[tool_call_id] = span
        elif event.event_type == "tool_call_result":
            opened = run.tools.pop(tool_call_id, None)
            if opened is None:
                return
            result = event.extra.get("result_json")
            if result is not None:
                self._set_outputs(opened, self._event_payload(result))
            outcome = "error" if isinstance(result, str) and '"error"' in result else "ok"
            self._close_tool_span(opened, "ERROR" if outcome == "error" else "OK")
{% endif %}

    def publish_status(self, update: StatusUpdate) -> None:
        """Forward status updates to callback or logs."""
        if self._status_callback:
            self._status_callback(update)
        else:
            self.logger.info(
                "status_update",
                extra={
                    "flow": self.flow_name,
                    "status": update.status,
                    "message": update.message,
                    "timestamp": update.timestamp.isoformat(),
                },
            )

    def record_circuit_breaker_state(self, service: str, state: str) -> None:
        """Record circuit breaker state change."""
        self._circuit_breaker_states[service] = state
        self.logger.info(
            "circuit_breaker_state_change",
            extra={"service": service, "state": state},
        )

    def get_metrics_summary(self) -> dict[str, Any]:
        """Get a summary of all collected metrics."""
        return {
            "flow_name": self.flow_name,
            "total_events": len(self.events),
            "latency_percentiles": {
                node: hist.percentiles()
                for node, hist in self._latency_histograms.items()
            },
            "error_rates": {
                node: tracker.stats()
                for node, tracker in self._error_trackers.items()
            },
            "circuit_breaker_states": dict(self._circuit_breaker_states),
        }
