"""Enterprise metrics helpers layered over PenguiFlow's shared telemetry."""

from __future__ import annotations

from collections import defaultdict, deque
from collections.abc import Callable
from dataclasses import dataclass, field
from datetime import UTC, datetime, timedelta
import logging
from typing import Any

from penguiflow.observability import AgentTelemetry as _AgentTelemetry
from penguiflow.observability import StatusUpdate
from penguiflow.planner import PlannerEvent


@dataclass
class LatencyHistogram:
    """Track recent latency samples and common percentiles."""

    window_size: int = 1000
    _samples: deque[float] = field(default_factory=deque, init=False)

    def record(self, latency_ms: float) -> None:
        self._samples.append(latency_ms)
        if len(self._samples) > self.window_size:
            self._samples.popleft()

    def percentiles(self) -> dict[str, float]:
        if not self._samples:
            return {"p50": 0.0, "p95": 0.0, "p99": 0.0, "mean": 0.0, "max": 0.0}
        samples = sorted(self._samples)
        count = len(samples)

        def percentile(value: float) -> float:
            return samples[min(int(count * value), count - 1)]

        return {
            "p50": percentile(0.50),
            "p95": percentile(0.95),
            "p99": percentile(0.99),
            "mean": sum(samples) / count,
            "max": max(samples),
        }


@dataclass
class ErrorRateTracker:
    """Track successes and failures within a rolling time window."""

    window_seconds: float = 60.0
    _successes: deque[datetime] = field(default_factory=deque, init=False)
    _failures: deque[datetime] = field(default_factory=deque, init=False)

    def record_success(self) -> None:
        self._successes.append(datetime.now(UTC))
        self._cleanup()

    def record_failure(self) -> None:
        self._failures.append(datetime.now(UTC))
        self._cleanup()

    def _cleanup(self) -> None:
        cutoff = datetime.now(UTC) - timedelta(seconds=self.window_seconds)
        while self._successes and self._successes[0] < cutoff:
            self._successes.popleft()
        while self._failures and self._failures[0] < cutoff:
            self._failures.popleft()

    def error_rate(self) -> float:
        self._cleanup()
        total = len(self._successes) + len(self._failures)
        return len(self._failures) / total if total else 0.0

    def stats(self) -> dict[str, Any]:
        self._cleanup()
        return {
            "successes": len(self._successes),
            "failures": len(self._failures),
            "error_rate": self.error_rate(),
            "window_seconds": self.window_seconds,
        }


class AgentTelemetry(_AgentTelemetry):
    """Shared tracing with enterprise metrics collection."""

    def __init__(
        self,
        *,
        flow_name: str,
        logger: logging.Logger,
        status_callback: Callable[[StatusUpdate], None] | None = None,
{% if mlflow_enabled %}
        mlflow_enabled: bool = False,
{% endif %}
    ) -> None:
        super().__init__(
            flow_name=flow_name,
            logger=logger,
            status_callback=status_callback,
{% if mlflow_enabled %}
            mlflow_enabled=mlflow_enabled,
{% endif %}
        )
        self._latency_histograms: defaultdict[str, LatencyHistogram] = defaultdict(LatencyHistogram)
        self._error_trackers: defaultdict[str, ErrorRateTracker] = defaultdict(ErrorRateTracker)
        self._circuit_breaker_states: dict[str, str] = {}

    def record_planner_event(self, event: PlannerEvent) -> None:
        super().record_planner_event(event)
        if event.event_type != "step_complete":
            return
        node_name = event.node_name or "unknown"
        payload = {"flow": self.flow_name, **event.to_payload()}
        if event.latency_ms is not None:
            self._latency_histograms[node_name].record(event.latency_ms)
            p95 = self._latency_histograms[node_name].percentiles()["p95"]
            if event.latency_ms > p95:
                self.logger.warning("high_latency_detected", extra={**payload, "p95": p95})
        if event.error:
            tracker = self._error_trackers[node_name]
            tracker.record_failure()
            error_rate = tracker.error_rate()
            if error_rate > 0.1:
                self.logger.error(
                    "high_error_rate",
                    extra={"node_name": node_name, "error_rate": error_rate, **tracker.stats()},
                )
        else:
            self._error_trackers[node_name].record_success()

    def record_circuit_breaker_state(self, service: str, state: str) -> None:
        self._circuit_breaker_states[service] = state
        self.logger.info("circuit_breaker_state_change", extra={"service": service, "state": state})

    def get_metrics_summary(self) -> dict[str, Any]:
        return {
            "flow_name": self.flow_name,
            "total_events": len(self.events),
            "latency_percentiles": {
                node: histogram.percentiles()
                for node, histogram in self._latency_histograms.items()
            },
            "error_rates": {node: tracker.stats() for node, tracker in self._error_trackers.items()},
            "circuit_breaker_states": dict(self._circuit_breaker_states),
        }


__all__ = ["AgentTelemetry", "ErrorRateTracker", "LatencyHistogram", "StatusUpdate"]
