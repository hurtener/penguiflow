MEMORY_BASE_URL=http://localhost:8000
WAYFINDER_BASE_URL=http://localhost:9100
LLM_MODEL=stub-llm
{% if mlflow_enabled %}
# MLflow tracking server (replace with your server URL)
MLFLOW_TRACKING_URI=http://localhost:5000
# Trace LLM calls with the same metadata-only hook for native and LiteLLM clients.
PENGUIFLOW_LLM_TRACING=mlflow
# For Databricks, use a configured profile instead:
# MLFLOW_TRACKING_URI=databricks://<profile>
{% endif %}
